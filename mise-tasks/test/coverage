#!/usr/bin/env bash
#MISE description="Run instrumented wasm tests and generate coverage reports"
#MISE depends=["setup:submodules"]
set -euo pipefail

moon coverage --target-dir _build/coverage clean
if moon test --target wasm --enable-coverage --target-dir _build/coverage; then
  coverage_test_status=0
else
  coverage_test_status=$?
fi
exec python3 .github/scripts/coverage_summary.py --exit-code "$coverage_test_status" --target-dir _build/coverage --output-dir _build/coverage-results
