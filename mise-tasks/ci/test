#!/usr/bin/env bash
#MISE description="Run the tests for one target, keep the log, and write exit_code to GITHUB_OUTPUT"
#USAGE flag "--target <target>" default="wasm" help="MoonBit target"
#USAGE flag "--coverage" help="Instrument the tests for coverage"
#USAGE flag "--log <file>" required=#true help="File that receives the test output"
set -euo pipefail

exec moon run -q --target wasm scripts/ci.mbtx -- test "$@"
