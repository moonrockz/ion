#!/usr/bin/env bash
#MISE description="Write mooncakes.io credentials from the MOONCAKES_USER_TOKEN environment variable"
set -euo pipefail

if [ -z "${MOONCAKES_USER_TOKEN:-}" ]; then
  echo "Error: MOONCAKES_USER_TOKEN is not set" >&2
  exit 1
fi
mkdir -p ~/.moon
printf '{"token": "%s"}\n' "$MOONCAKES_USER_TOKEN" > ~/.moon/credentials.json
echo "Mooncakes credentials written to ~/.moon/credentials.json"
