// The `ion` command-line tool.

import {
  "moonrockz/ion/ion" @core,
  "moonrockz/ion/binary",
  "moonrockz/ion/hash",
  "moonrockz/ion/json",
  "moonrockz/ion/schema",
  "moonrockz/ion/text",
  "moonrockz/ion/binary/stream" @binary_stream,
  "moonrockz/ion/text/stream" @text_stream,
  "moonbitlang/async",
  "moonbitlang/async/fs" @async_fs,
  "moonbitlang/async/io",
  "moonbitlang/async/os_error",
  "moonbitlang/async/stdio",
  "moonbitlang/core/env",
  "moonbitlang/x/fs",
  "moonbitlang/x/sys",
}

// The CLI reads files and stdin through `moonbitlang/async`, which supports
// only these targets. The library packages build on every target.

supported_targets = "native+wasm"

pkgtype(kind: "executable")
