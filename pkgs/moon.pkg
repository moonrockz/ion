// The `ion` command-line tool.

import {
  "moonrockz/ion/cli",
  "moonbitlang/async",
  "moonbitlang/async/stdio",
  "moonbitlang/core/env",
  "moonbitlang/x/sys",
}

// The CLI reads files and stdin through `moonbitlang/async`, which supports
// only these targets. The library packages build on every target.

supported_targets = "native+wasm"

pkgtype(kind: "executable")
