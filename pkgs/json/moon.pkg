// JSON interoperability: converting between Ion values and core `Json`.
//
// The two directions are deliberately asymmetric; see the `Ion` constructor
// and `to_json.mbt` for the rules each one follows.

import {
  "moonrockz/ion/internal/work",
  "moonrockz/ion/ion" @core,
  "moonbitlang/core/json" @cjson,
}

import {
  "moonrockz/ion/ion" @core,
  "moonrockz/ion/text",
  "moonbitlang/core/json" @cjson,
  "moonbitlang/core/quickcheck",
  "moonrockz/ion/testkit",
} for "test"
