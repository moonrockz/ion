// Ion text over asynchronous IO.
//
// The sync reader in `moonrockz/ion/text` parses a string that is already in
// memory. This package adapts it to `moonbitlang/async` byte sources: a
// streaming reader decodes UTF-8 as it arrives and parses one top-level value
// at a time, so a large stream never has to be buffered whole.

import {
  "moonrockz/ion/ion",
  "moonrockz/ion/text",
  "moonbitlang/async/io",
  "moonbitlang/core/encoding/utf8",
}

import {
  "moonrockz/ion/ion",
  "moonrockz/ion/text",
  "moonbitlang/async",
  "moonbitlang/async/io",
  "moonbitlang/core/encoding/utf8",
} for "test"
